# Mẫu cấu hình. Sao chép thành .env.local rồi điền khóa của bạn. KHÔNG điền khóa thật vào file này.
# Thứ tự ưu tiên: biến môi trường của terminal > .env.local > .env
# .env và .env.local đã nằm trong .gitignore, không được commit.

# Địa chỉ API theo chuẩn OpenAI Chat Completions. Để trống thì dùng OpenRouter.
#   OpenRouter: https://openrouter.ai/api/v1/chat/completions
#   DeepSeek:   https://api.deepseek.com/chat/completions
AI_ENDPOINT=

# Khóa API của dịch vụ ở trên (OpenRouter: sk-or-v1-..., DeepSeek: sk-...).
AI_API_KEY=

# Tên model theo dịch vụ, ví dụ nvidia/nemotron-3-ultra-550b-a55b:free (OpenRouter) hoặc deepseek-chat (DeepSeek).
# Dùng đúng một model cho mọi cặp trong một lần thực nghiệm.
AI_MODEL=
